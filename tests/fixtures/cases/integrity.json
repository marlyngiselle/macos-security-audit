{
  "area": "integrity",
  "cases": [
    {
      "check": "MA-INT-01",
      "expect": "pass",
      "commands": {
        "spctl --status": {
          "stdout": "assessments enabled\n"
        }
      }
    },
    {
      "check": "MA-INT-01",
      "expect": "fail",
      "commands": {
        "spctl --status": {
          "stdout": "assessments disabled\n"
        }
      }
    },
    {
      "check": "MA-INT-01",
      "expect": "unknown",
      "commands": {
        "spctl --status": {
          "stdout": "",
          "exit": 1,
          "stderr": "spctl: internal error\n"
        }
      }
    },
    {
      "check": "MA-INT-02",
      "expect": "pass",
      "commands": {
        "csrutil status": {
          "stdout": "System Integrity Protection status: enabled.\n"
        }
      }
    },
    {
      "check": "MA-INT-02",
      "expect": "fail",
      "commands": {
        "csrutil status": {
          "stdout": "System Integrity Protection status: disabled.\n"
        }
      }
    },
    {
      "check": "MA-INT-02",
      "expect": "fail",
      "commands": {
        "csrutil status": {
          "stdout": "System Integrity Protection status: enabled (Custom Configuration).\n\nConfiguration:\n\tKext Signing: disabled\n"
        }
      },
      "name": "custom configuration"
    },
    {
      "check": "MA-INT-02",
      "expect": "unknown",
      "commands": {
        "csrutil status": {
          "stdout": "",
          "exit": 1,
          "stderr": "csrutil: failed to read the current configuration\n"
        }
      }
    },
    {
      "check": "MA-INT-03",
      "expect": "pass",
      "commands": {
        "csrutil authenticated-root status": {
          "stdout": "Authenticated Root status: enabled\n"
        }
      }
    },
    {
      "check": "MA-INT-03",
      "expect": "fail",
      "commands": {
        "csrutil authenticated-root status": {
          "stdout": "Authenticated Root status: disabled\n"
        }
      }
    },
    {
      "check": "MA-INT-03",
      "expect": "unknown",
      "commands": {
        "csrutil authenticated-root status": {
          "stdout": "",
          "exit": 64,
          "stderr": "usage: csrutil <command>\n"
        }
      }
    },
    {
      "check": "MA-INT-04",
      "expect": "pass",
      "commands": {
        "defaults read /Library/Apple/System/Library/CoreServices/XProtect.bundle/Contents/Info.plist CFBundleShortVersionString": {
          "stdout": "5297\n"
        }
      }
    },
    {
      "check": "MA-INT-04",
      "expect": "fail",
      "commands": {
        "defaults read /Library/Apple/System/Library/CoreServices/XProtect.bundle/Contents/Info.plist CFBundleShortVersionString": {
          "exit": 1,
          "stdout": "",
          "stderr": "2026-10-26 09:00:00.000 defaults[4242:1337] \nThe domain/default pair of (/Library/Apple/System/Library/CoreServices/XProtect.bundle/Contents/Info.plist, CFBundleShortVersionString) does not exist\n"
        }
      }
    },
    {
      "check": "MA-INT-04",
      "expect": "fail",
      "commands": {
        "defaults read /Library/Apple/System/Library/CoreServices/XProtect.bundle/Contents/Info.plist CFBundleShortVersionString": {
          "stdout": "0\n"
        }
      },
      "name": "zero version"
    },
    {
      "check": "MA-INT-04",
      "expect": "unknown",
      "commands": {
        "defaults read /Library/Apple/System/Library/CoreServices/XProtect.bundle/Contents/Info.plist CFBundleShortVersionString": {
          "stdout": "2.0.beta\n"
        }
