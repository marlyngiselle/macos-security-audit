{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marlyngiselle/macos-security-audit/macaudit/data/catalogue.schema.json",
  "title": "macaudit check catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "areas", "checks"],
  "$defs": {
    "status": {"enum": ["pass", "fail", "unknown", "skipped"]},
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "status"],
      "properties": {
        "when": {"enum": ["regex", "exit", "int_range", "line_count"]},
        "pattern": {"type": "string"},
        "codes": {"type": "array", "items": {"type": "integer"}},
        "negate": {"type": "boolean"},
        "min": {"type": "integer"},
        "max": {"type": "integer"},
        "status": {"$ref": "#/$defs/status"},
        "otherwise": {"$ref": "#/$defs/status"},
        "reason": {"type": "string"},
        "otherwise_reason": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"when": {"enum": ["regex", "int_range"]}}}, "then": {"required": ["pattern"]}},
        {"if": {"properties": {"when": {"const": "exit"}}}, "then": {"required": ["codes"]}},
        {"if": {"properties": {"when": {"const": "line_count"}}}, "then": {"required": ["max"]}}
      ]
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "areas": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {"title": {"type": "string"}, "description": {"type": "string"}}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "area", "severity", "rationale", "expected", "probe", "remediation", "references"],
        "properties": {
          "id": {"type": "string", "pattern": "^MA-[A-Z]{2,3}-\\d{2}$"},
          "title": {"type": "string", "minLength": 5},
          "area": {"type": "string"},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "rationale": {"type": "string", "minLength": 20},
          "expected": {"type": "string"},
          "sensitive": {"type": "boolean"},
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["command", "builtin"]},
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "name": {"type": "string"},
              "params": {"type": "object"},
              "env": {"type": "object", "additionalProperties": {"type": "string"}},
              "timeout": {"type": "integer", "minimum": 1, "maximum": 600},
              "requires_root": {"type": "boolean"}
            },
            "allOf": [
              {"if": {"properties": {"type": {"const": "command"}}}, "then": {"required": ["argv"]}},
              {"if": {"properties": {"type": {"const": "builtin"}}}, "then": {"required": ["name"]}}
            ]
          },
          "evaluate": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
          "remediation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "references": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {"if": {"properties": {"probe": {"properties": {"type": {"const": "command"}}}}}, "then": {"required": ["evaluate"]}}
        ]
      }
    }
  }
}
